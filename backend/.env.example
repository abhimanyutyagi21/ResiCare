PORT=5000

# Neon connection string: Neon dashboard → your project → Connect → copy the string.
# Use the POOLED one (host contains "-pooler") for the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional: the DIRECT string (no "-pooler"), used only by db:migrate / db:seed. Falls back to DATABASE_URL.
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origins allowed to call the API (only needed when they differ).
CLIENT_ORIGIN=http://localhost:5173

# Anyone signing up as "admin" must enter this code. Leave empty to disable admin sign-up.
ADMIN_INVITE_CODE=resicare-admin-2026

# Where uploaded complaint photos/videos are stored (Neon stores data only, not files).
UPLOAD_DIR=./uploads
